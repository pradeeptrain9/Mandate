# PayPal sandbox app credentials, from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Created under Apps & Credentials -> your app -> Webhooks. Required to verify
# deliveries; an unverified webhook endpoint is not an endpoint, it is a hole.
PAYPAL_WEBHOOK_ID=

# HMAC key for the decision ledger. Any long random string; losing it makes
# existing records unverifiable, so keep it out of the repo.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_LEDGER_KEY=

# Keys that no longer sign anything but still have to verify older records.
# Comma-separated. An append-only ledger outlives its key -- re-signing the past
# would mean rewriting it -- so rotating means moving the old value here, not
# deleting it. Without this, every record written before a rotation reports as
# unverifiable, which is indistinguishable from someone having edited the file.
MANDATE_LEDGER_RETIRED_KEYS=

# Shared secret the merchant stub signs its quotes with.
MANDATE_MERCHANT_SECRET=

# Which model drives the agent. Either works; the firewall's behaviour does not
# depend on the choice, which is rather the point -- see src/mandate/agent/loop.py.
# Set MANDATE_PROVIDER to pin one, otherwise the first configured key wins.
MANDATE_PROVIDER=

# Gemini. Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Hard cap on model spend, in USD, checked before every request.
MANDATE_LLM_CAP_USD=5.00

# Twilio, for the over-threshold approval SMS. Optional: without it the
# approval queue still works in the dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MANDATE_APPROVER_NUMBER=

# Public base URL the approval link points at, and PayPal returns the buyer to.
MANDATE_PUBLIC_URL=http://localhost:8000

# Whether a buyer approving at PayPal immediately reserves their funds. On by
# default: the policy already allowed that exact basket and the order already
# exists, so holding the authorize step back would mean an agent cannot finish a
# purchase without a human pressing a second button for no reason. Set to 0 to
# review before reserving.
MANDATE_AUTO_PLACE=1
